load("@rules_go//go:def.bzl", "go_library", "go_test")

# Publicly visible: relying parties outside this repository check their own
# corpora of tlog-proofs against candidate policies using this package.
go_library(
    name = "policycheck",
    srcs = [
        "implies.go",
        "proof.go",
        "quorum.go",
    ],
    importpath = "github.com/google/google-tlog-witness/policycheck",
    visibility = ["//visibility:public"],
    deps = [
        "@com_github_transparency_dev_formats//policy",
        "@com_github_transparency_dev_formats//proof",
        "@org_golang_x_mod//sumdb/note",
    ],
)

go_test(
    name = "policycheck_test",
    srcs = [
        "helpers_test.go",
        "implies_test.go",
        "proof_test.go",
    ],
    deps = [
        ":policycheck",
        "@com_github_transparency_dev_formats//note",
        "@com_github_transparency_dev_formats//policy",
        "@com_github_transparency_dev_formats//proof",
        "@org_golang_x_mod//sumdb/note",
    ],
)
