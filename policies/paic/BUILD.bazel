load("//build_defs:tlog.bzl", "tlog_policy", "tlog_policy_pair", "tlog_policy_pair_test")

# Any two of cloudflare, geomys and glasklar.
#
# The tf witness is still contacted, and its cosignatures kept where
# available, but is not required.
PAIC_GROUPS = [
    "group cloudflare-geomys-glasklar 2 cloudflare geomys glasklar",
]

PAIC_QUORUM = "cloudflare-geomys-glasklar"

PAIC_WITNESSES = [
    "//witnesses:transparency-dev.txt",
    "//witnesses:cloudflare.txt",
    "//witnesses:geomys.txt",
    "//witnesses:glasklar.txt",
]

# Production log and verifier policies.
tlog_policy_pair(
    name = "prod",
    groups = PAIC_GROUPS,
    log_lists = ["//logs/paic:log-list.txt"],
    quorum = PAIC_QUORUM,
    visibility = ["//visibility:public"],
    witnesses = PAIC_WITNESSES,
)

# Development log and verifier policies.
tlog_policy_pair(
    name = "dev",
    groups = PAIC_GROUPS,
    log_lists = ["//logs/paic:log-list-dev.txt"],
    quorum = PAIC_QUORUM,
    visibility = ["//visibility:public"],
    witnesses = PAIC_WITNESSES,
)

# Verifier policy trusting both the development and production logs.
#
# This is a verifier policy only: nothing appends to a combined "dev and prod"
# log, so there is no corresponding log policy and no tlog_policy_pair.
#
# It exists for non-production relying parties, which see a mixture of
# evidence.
#
# Production relying parties must NOT use this policy: they should trust the
# production log alone, via ":prod-verifier".
tlog_policy(
    name = "dev-prod-verifier",
    groups = PAIC_GROUPS,
    log_lists = [
        "//logs/paic:log-list.txt",
        "//logs/paic:log-list-dev.txt",
    ],
    quorum = PAIC_QUORUM,
    visibility = ["//visibility:public"],
    witnesses = PAIC_WITNESSES,
)

# There is no tlog_policy_pair to relate ":dev-prod-verifier" to the logs it
# trusts, so check each log policy against it directly: neither log may publish
# a checkpoint that ":dev-prod-verifier" would reject.
tlog_policy_pair_test(
    name = "dev-prod-verifier.dev-log.policy-pair-test",
    log_policy = ":dev-log.policy",
    verifier_policy = ":dev-prod-verifier.policy",
)

tlog_policy_pair_test(
    name = "dev-prod-verifier.prod-log.policy-pair-test",
    log_policy = ":prod-log.policy",
    verifier_policy = ":dev-prod-verifier.policy",
)
