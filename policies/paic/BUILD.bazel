load("//build_defs:tlog.bzl", "tlog_policy", "tlog_policy_pair")

# tlog-policy permits each name to be a group member at most once, so the
# groups are nested rather than listing geomys and glasklar twice.
PAIC_GROUPS = [
    "group geomys-glasklar all geomys glasklar",
    "group tf-geomys-glasklar all tf geomys-glasklar",
]

# Production log and verifier policies.
#
# The tf witness is being dropped from the quorum (it will still be contacted
# and its cosignatures kept where available). Per "Policy rollout" in
# README.md, the verifier quorum is relaxed first; the log quorum follows once
# this has baked.
tlog_policy_pair(
    name = "prod",
    groups = PAIC_GROUPS,
    log_lists = ["//logs/paic:log-list.txt"],
    quorum = "tf-geomys-glasklar",
    verifier_quorum = "geomys-glasklar",
    visibility = ["//visibility:public"],
    witnesses = [
        "//witnesses:transparency-dev.txt",
        "//witnesses:geomys.txt",
        "//witnesses:glasklar.txt",
    ],
)

# Development log and verifier policies.
#
# See the rollout note on ":prod" above.
tlog_policy_pair(
    name = "dev",
    groups = PAIC_GROUPS,
    log_lists = ["//logs/paic:log-list-dev.txt"],
    quorum = "tf-geomys-glasklar",
    verifier_quorum = "geomys-glasklar",
    visibility = ["//visibility:public"],
    witnesses = [
        "//witnesses:transparency-dev.txt",
        "//witnesses:geomys.txt",
        "//witnesses:glasklar.txt",
    ],
)

# Verifier policy trusting both the development and production logs.
#
# This is a verifier policy only: nothing appends to a combined "dev and prod"
# log, so there is no corresponding log policy and no tlog_policy_pair.
#
# It exists for non-production relying parties, which see a mixture of
# evidence.
#
# Production relying parties must NOT use this policy: they should trust the
# production log alone, via ":prod-verifier".
tlog_policy(
    name = "dev-prod-verifier",
    groups = PAIC_GROUPS,
    log_lists = [
        "//logs/paic:log-list.txt",
        "//logs/paic:log-list-dev.txt",
    ],
    quorum = "geomys-glasklar",
    visibility = ["//visibility:public"],
    witnesses = [
        "//witnesses:transparency-dev.txt",
        "//witnesses:geomys.txt",
        "//witnesses:glasklar.txt",
    ],
)
